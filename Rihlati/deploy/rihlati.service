[Unit]
Description=Rihlati web and mobile API - Team Siraj
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rihlati
Group=rihlati
WorkingDirectory=/opt/rihlati/Rihlati
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RIHLATI_ENV=production
Environment=RIHLATI_HOST=127.0.0.1
Environment=PORT=8080
Environment=PUBLIC_URL=https://rihlati.me
Environment=RIHLATI_TRUST_PROXY=loopback
Environment=RIHLATI_ENV_FILE=/opt/rihlati/Rihlati/data/private/.enviroment.local
Environment=RIHLATI_PDFTOPPM=/usr/bin/pdftoppm
ExecStart=/opt/rihlati/Rihlati/.venv/bin/python /opt/rihlati/Rihlati/scripts/api_server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rihlati/Rihlati/data /opt/rihlati/Rihlati/references
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
