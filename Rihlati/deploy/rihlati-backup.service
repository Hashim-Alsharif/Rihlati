[Unit]
Description=Consistent Rihlati database snapshot (private, local only)

[Service]
Type=oneshot
User=rihlati
Group=rihlati
WorkingDirectory=/opt/rihlati/Rihlati
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rihlati/Rihlati/.venv/bin/python /opt/rihlati/Rihlati/scripts/backup_data.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rihlati/Rihlati/data
